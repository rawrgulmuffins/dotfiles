urlencode() {
    # urlencode <string>

    old_lc_collate=$LC_COLLATE
    LC_COLLATE=C

    local length="${#1}"
    for (( i = 0; i < length; i++ )); do
        local c="${1:$i:1}"
        case $c in
            [a-zA-Z0-9.~_-]) printf '%s' "$c" ;;
            *) printf '%%%02X' "'$c" ;;
        esac
    done

    LC_COLLATE=$old_lc_collate
}

urldecode() {
    # urldecode <string>

    local url_encoded="${1//+/ }"
    printf '%b' "${url_encoded//%/\\x}"
}

# ------------------------------ Aliases ------------------------------
# Debian and Ubuntu install bat as batcat, since another package owns the name.
if (( ! $+commands[bat] && $+commands[batcat] )); then
    alias bat='batcat'
fi
if (( $+commands[lsd] )); then
    alias ls='lsd -Al --sort=time --git --reverse --group-dirs=first'
fi
if (( $+commands[bat] || $+commands[batcat] )); then
    alias cat='bat'
fi
alias rg='rg --smart-case'
alias cdev='make -C ~/git/claude-dev-container run'

if [ -f ~/.bash_aliases ]; then
    source ~/.bash_aliases
fi

