export PATH="$HOME/.local/bin:$PATH"

export EDITOR="nvim"
export VISUAL="$EDITOR"

# Lets gpg prompt for a passphrase in the terminal, for signed commits.
export GPG_TTY=$(tty)

# ---------------------------------- Modules ----------------------------------
# Optional pieces of config live in $ZSH_CONFIG_DIR/modules, one file each.
# The OS modules load automatically. Everything else is opted into from
# ~/.zshrc.local, which is sourced at the end of this file and never committed.
ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

load_zsh_module() {
    local module_file="$ZSH_CONFIG_DIR/modules/$1.zsh"
    if [[ -r "$module_file" ]]; then
        source "$module_file"
    else
        print -u2 "zshrc: module '$1' not found at $module_file"
        return 1
    fi
}

if [[ "$OSTYPE" == darwin* ]]; then
    load_zsh_module macos
elif [[ -r /proc/version && "$(</proc/version)" == *[Mm]icrosoft* ]]; then
    load_zsh_module wsl
fi

# ------------------------ Shell History Configuration ------------------------
# zsh saves no history unless these are set. macOS sets them in /etc/zshrc,
# Ubuntu doesn't.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt EXTENDED_HISTORY       # Save start time and wall time of command
setopt SHARE_HISTORY          # Append each command as it runs and read other shells' commands
setopt HIST_EXPIRE_DUPS_FIRST # Delete duplicates first when trimming to HISTSIZE
setopt HIST_IGNORE_ALL_DUPS   # Drop an older copy of a command when it's repeated
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE      # Don't save commands that start with a space
setopt HIST_REDUCE_BLANKS     # Why is this not a default?
setopt HIST_NO_STORE          # Don't save the history command itself
setopt HIST_VERIFY            # Show a history expansion before running it

# ------------------------------ Completion Stuff ------------------------------

bindkey -M viins '\C-i' complete-word

# Faster! (?)
zstyle ':completion::complete:*' use-cache 1

# case insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:messages' format '%d'
zstyle ':completion:*:warnings' format 'No matches for: %d'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' completer _expand _complete _approximate _ignored


# generate descriptions with magic.
zstyle ':completion:*' auto-description 'specify: %d'

# Don't prompt for a huge list, page it!
zstyle ':completion:*:default' list-prompt '%S%M matches%s'

# Don't prompt for a huge list, menu it!
zstyle ':completion:*:default' menu 'select=0'

# Sort file completions by modification time, newest last. The list prints
# below the command line, so the last row is the one nearest where the screen
# settles on a long list. Drop 'reverse' to put newest at the top instead.
zstyle ':completion:*' file-sort modification reverse

# Show file completions in ls -l format so the modification timestamp the sort
# above is keyed on is actually visible in the list.
zstyle ':completion:*' file-list all

# Required for the paging that list-prompt above asks for, and for menu
# selection. Not autoloaded by either style.
zmodload zsh/complist

# No list-colors here on purpose. file-list builds each row itself and hands it
# to compadd as a pre-rendered display string, so complist never runs its color
# pass over the result. Setting list-colors alongside file-list does nothing.
# Colors are available only by dropping file-list and losing the timestamps.

unsetopt LIST_AMBIGUOUS

# bashcompinit lets tools that only ship bash completions (terraform's
# `complete -C`, for one) register them here.
autoload -U compinit && compinit
autoload -U bashcompinit && bashcompinit
