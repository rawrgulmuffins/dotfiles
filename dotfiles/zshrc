# ---------------------------------- Functions ------------------------------------
gcfb() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null)
  if [[ -z "$branch" ]]; then
    echo "Not in a git repository or detached HEAD" >&2
    return 1
  fi

  if [[ "$branch" =~ ^([A-Z]+-[0-9]+)-(.+)$ ]]; then
    local ticket="${match[1]}"
    local title="${match[2]}"
    local message="${ticket}: ${title//-/ }"
    echo "Committing with message: '$message'"
    git commit -a -m "$message"
  else
    echo "Branch name '$branch' doesn't match expected pattern (e.g. SP-6970-Add-ECR-Targets)" >&2
    return 1
  fi
}

# Helper functions used by tmux to rename window panes based on the current directory
# and git repo.
tmux_rename_window_preexec() {
  if [ -n "$TMUX" ]; then
    local cmd="$1"
    local mode
    case "$cmd" in
      vim*|nvim*)  mode="vim" ;;
      psql*)       mode="psql" ;;
      ssh*)        mode="ssh" ;;
      *)           return ;;  # let precmd handle terminal
    esac

    local repo
    repo=$(git rev-parse --show-toplevel 2>/dev/null)
    local base
    if [ -n "$repo" ]; then
      base=$(basename "$repo")
    else
      base=$(basename "$PWD")
    fi

    tmux rename-window "${base}-${mode}"
  fi
}

tmux_rename_window() {
  if [ -n "$TMUX" ]; then
    local pane_cmd
    pane_cmd=$(tmux display-message -p '#{pane_current_command}')

    local mode
    case "$pane_cmd" in
      vim|nvim)   mode="vim" ;;
      psql)       mode="psql" ;;
      ssh)        mode="ssh" ;;
      *)          mode="terminal" ;;
    esac

    local repo
    repo=$(git rev-parse --show-toplevel 2>/dev/null)
    local base
    if [ -n "$repo" ]; then
      base=$(basename "$repo")
    else
      base=$(basename "$PWD")
    fi

    tmux rename-window "${base}-${mode}"
  fi
}

pull-all-repos() {
    local repo_root="${1:-$HOME/git}"
    local repo_dir current_branch default_branch
    local -a failed_repos

    for repo_dir in "$repo_root"/*/; do
      [[ -d "$repo_dir/.git" ]] || continue
      repo_dir="${repo_dir%/}"
      echo "==> ${repo_dir##*/}"
      (
        cd "$repo_dir" || exit 1
        # Refresh from the remote rather than trusting a possibly-stale cached
        # origin/HEAD -- a repo's default branch can be renamed upstream
        # (develop -> main, etc.) without this clone ever finding out otherwise.
        git remote set-head origin -a >/dev/null 2>&1
        default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
        if [[ -z "$default_branch" ]]; then
          default_branch=$(git remote show origin 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}')
        fi
        if [[ -z "$default_branch" ]]; then
          echo "  could not determine default branch, skipping"
          exit 1
        fi
        current_branch=$(git branch --show-current)
        if [[ "$current_branch" != "$default_branch" ]]; then
          git checkout "$default_branch" || exit 1
        fi
        git pull --ff-only
      )
      if (( $? != 0 )); then
        failed_repos+=("${repo_dir##*/}")
      fi
    done

    if (( ${#failed_repos[@]} > 0 )); then
      echo
      echo "Failed to pull:"
      for repo_dir in "${failed_repos[@]}"; do
        echo "  - $repo_dir"
      done
    fi
  }

