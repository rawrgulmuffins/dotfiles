# Copy to ~/.gitconfig.local and edit.

[user]
	name = Alex LordThorsen
	email = you@example.com

# Send GitHub HTTPS URLs over ssh instead. Only turn this on once ssh keys are
# set up for GitHub. Without them, every clone and fetch from GitHub fails,
# including Neovim's plugin installs.
# [url "git@github.com:"]
# 	insteadOf = https://github.com/
